// Complete Hack computer: CPU + Memory + ROM32K.
CHIP Computer {
    IN reset;

    PARTS:
    ROM32K(address=pc, out=instruction);
    CPU(
        inM=memoryOut,
        instruction=instruction,
        reset=reset,
        outM=outM,
        writeM=writeM,
        addressM=addressM,
        pc=pc
    );
    Memory(
        in=outM,
        load=writeM,
        address=addressM,
        out=memoryOut
    );
}